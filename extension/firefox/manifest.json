{
  "manifest_version": 3,
  "name": "Intercept · Native Origin",
  "version": "0.5.0",
  "description": "Observe YouTube request metadata and compare native-origin and reverse-proxy execution environments.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "activeTab",
    "proxy"
  ],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://googlevideo.com/*",
    "https://*.googlevideo.com/*",
    "https://googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://gstatic.com/*",
    "https://*.gstatic.com/*",
    "https://ytimg.com/*",
    "https://*.ytimg.com/*",
    "http://localhost/*",
    "http://*.localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Intercept Native Origin",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "intercept-native-origin@jordanlegare",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "http://localhost/*",
        "http://*.localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "worker_probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
