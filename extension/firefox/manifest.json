{
  "manifest_version": 3,
  "name": "Intercept · Native Origin",
  "version": "0.1.0",
  "description": "Observe YouTube request lifecycle metadata without replacing the browser's native origin or network path.",
  "permissions": ["storage", "tabs", "webRequest"],
  "host_permissions": [
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://googlevideo.com/*",
    "https://*.googlevideo.com/*",
    "https://googleapis.com/*",
    "https://*.googleapis.com/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "background": {"scripts": ["background.js"]},
  "action": {"default_title": "Intercept Native Origin", "default_popup": "popup.html"},
  "browser_specific_settings": {
    "gecko": {"id": "intercept-native-origin@jordanlegare", "strict_min_version": "121.0"}
  }
}