{
  "manifest_version": 3,
  "name": "Playback Capture",
  "version": "1.4.2",
  "description": "Queue YouTube selections, wait through ads, and guide users to Firefox autoplay permissions when background playback is blocked.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Activate Playback Capture on www.youtube.com"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "playback-capture@jordanlegare",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "personallyIdentifyingInfo",
          "websiteContent",
          "websiteActivity"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "capture_core.js",
        "youtube_player_api.js",
        "video_download.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "download_bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inline_record.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
