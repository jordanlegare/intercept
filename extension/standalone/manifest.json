{
  "manifest_version": 3,
  "name": "Playback Capture",
  "version": "1.3.5",
  "description": "Queue YouTube video selections while browsing; process inactive captures sequentially and download each WebM.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Activate Playback Capture on www.youtube.com"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "playback-capture@jordanlegare",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "capture_core.js",
        "video_download.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*"
      ],
      "js": [
        "download_bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "inline_record.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
